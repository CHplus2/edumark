# Any OpenAI-compatible provider. Leave LLM_API_KEY empty to use the offline mock marker (demo/backup).
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai   model: gemini-2.0-flash (check current names)
# Groq:    https://api.groq.com/openai/v1                            model: llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
MAX_SUBMISSION_CHARS=20000
